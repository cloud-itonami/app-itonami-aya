;; app-slides — itonami（dapp）の aiueos アプリ記述子（notes.edn 形）。
;; 判定コアは aiueos/slides_surface.cljk（appview 面宣言の整合判定）。
;; 正本は appview/slides-mcp-component/cljs/src/slides/state.cljs（app-info）。
;; pure（:effects #{}）。
{:aiueos/component :app/slides-surface
 :aiueos/kind :app
 :aiueos/trust :untrusted
 :aiueos/source "slides_surface.cljk"
 :aiueos/wasm "slides_surface.wasm"
 :aiueos/entry "main"
 :aiueos/args []
 :aiueos/imports #{}
 :aiueos/exports #{:app/main
                   :app/route-count-ok
                   :app/kind-ok
                   :app/surface-judgment}
 :aiueos/effects #{}
 :aiueos/limits {:memory-pages 16 :fuel 5000000}}
