{
  "name": "kotodama-slides-mcp",
  "main": "src/app.ts",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"bpmn-dispatch\",\"oauth-redirect\"]",
    "APP_DESCRIPTION": "Thin edge facade; Google Slides OAuth and sync run in BPMN + Zeebe Python",
    "APP_DISPLAY_NAME": "Google Slides",
    "APP_EMBED_URL": "https://aya-mcp.itonami.app/?embed=1",
    "APP_FRAMEWORK": "cljs-reagent-kotoba-ui",
    "APP_NANOID": "slides-mcp",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "appview",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.itonami.app/xrpc/app.itonami.mcp.message"
  },
  "routes": [
    {
      "pattern": "aya-mcp.itonami.app/*",
      "zone_name": "itonami.app"
    },
    {
      "pattern": "aya.itonami.app/*",
      "zone_name": "itonami.app"
    }
  ],
  "assets": {
    "directory": "./cljs/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
