{
  "@context": "https://itonami.app/ns/kotodama/v1",
  "@id": "did:web:aya.itonami.app",
  "name": "slides",
  "nanoid": "slides-mcp",
  "performerType": "service",
  "runtimeType": "worker",
  "project": "slides",
  "component": {
    "path": "src/app.ts"
  },
  "build": {
    "guestLanguage": "ts",
    "role": "thin-edge"
  },
  "profile": {
    "displayName": "Google Slides",
    "description": "Thin edge facade; Google Slides OAuth and sync run in AgentGateway MCP + pod-side LangServer",
    "isBot": true,
    "agentType": "autonomous",
    "category": "google-workspace",
    "operator": "itonami.app",
    "capabilities": ["bpmn-dispatch", "oauth-redirect"]
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.itonami.aya.account",
        "app.itonami.aya.syncJob"
      ]
    }
  }
}
