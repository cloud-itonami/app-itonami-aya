(ns slides.surface-parity-test
  "aiueos/slides_surface.cljk（判定コア）と slides.state の宣言の parity。
  app-info の値が guest の整合規則（route-count 一致 / kind 閉じた集合 /
  source path / xrpc 一貫）を満たすこと。reagent 依存のため fixture 形。"
  (:require [clojure.test :refer [deftest is testing]]))

(def app-info
  ;; state.cljs の app-info（field for field）
  {:title "Slides Mcp Component"
   :project "itonami-aya"
   :name "slides-mcp-component"
   :kind "appview"
   :route-count 0
   :routes []
   :vars []
   :xrpc true
   :relative-path "appview/slides-mcp-component/cljs/src/slides/ui.cljs"})

(defn- route-count-ok [declared n-actual] (if (= declared n-actual) 1 0))
(defn- kind-code [kind] (get {"appview" 0 "worker" 1 "component" 2 "app" 3} kind -1))

(deftest declared-surface-satisfies-guest-rules
  (testing "guest test-count: route-count は routes の数と一致"
    (is (= 1 (route-count-ok (:route-count app-info) (count (:routes app-info))))))
  (testing "guest test-kind: kind は閉じた集合（appview = 0）"
    (is (= 0 (kind-code (:kind app-info)))))
  (testing "guest test-surface: source path の明示と xrpc の一貫"
    (is (string? (:relative-path app-info)))
    (is (true? (:xrpc app-info))))
  (testing "guest test-count-bad / test-fail-closed: 壊れた宣言は検出される"
    (is (= 0 (route-count-ok (inc (:route-count app-info)) (count (:routes app-info)))))
    (is (= -1 (kind-code "nonexistent")))))
